---
import Layout from '../components/Layout.astro';
import { siteConfig } from '../config.ts';
import { servicesContent } from '../content/services';
import { consultingIMContent } from '../content/consulting-im';
import * as LucideIcons from 'lucide-astro';
import { marked } from 'marked';

const service = servicesContent[1];
const bodyHtml = await marked(service.body);
---

<Layout
  title={`${service.title} - ${siteConfig.site.title}`}
  description={service.description}
>
  <main class="min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mt-12 mb-12">
        <h1 class="mb-8 text-center text-5xl font-bold">{service.title}</h1>
        <div
          class="gap-8 text-lg leading-relaxed text-gray-700 md:columns-2 [&>p]:mb-4"
          set:html={bodyHtml}
        />
      </div>

      {
        consultingIMContent.map((group, groupIndex) => (
          <section class="mt-16">
            <h2 class="scroll-fade-up mb-8 text-center text-3xl font-bold">
              {group.groupTitle}
            </h2>
            <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
              {group.items.map((item, itemIndex) => {
                const IconComponent = LucideIcons[item.icon];
                return (
                  <div
                    class={`group scroll-fade-up border-mono-lighter block rounded-xl border bg-(--color-bg-card) p-8 stagger-${((groupIndex * 3 + itemIndex) % 9) + 1} transition-shadow hover:shadow-lg`}
                  >
                    <div class="mb-3 flex items-center gap-4">
                      <div class="feature-icon flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-orange text-white">
                        <IconComponent class="h-7 w-7" />
                      </div>
                      <h3 class="text-mono-black card-title text-xl font-semibold">
                        {item.title}
                      </h3>
                    </div>
                    <p class="text-mono-dark leading-relaxed">
                      {item.description}
                    </p>
                  </div>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</Layout>
