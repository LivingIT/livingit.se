---
import Layout from '../components/Layout.astro';
import { Image } from 'astro:assets';
import { siteConfig, getImageSrcSet, imageSizes } from '../config.ts';
import { contactContent } from '../content/contact';
import * as LucideIcons from 'lucide-astro';
import { marked } from 'marked';

const contactGeneralHtml = await marked(contactContent.contactGeneral.text);
const contactStartHtml = await marked(contactContent.contactStart.text);

const getInitials = (name: string) =>
  name
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join('')
    .toUpperCase();
---

<Layout
  title={`Kontakta oss - ${siteConfig.site.title}`}
  description={siteConfig.site.description}
>
  <main class="min-h-screen">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <header class="mt-12 mb-12 text-center">
        <h1 class="mb-6 text-5xl font-bold">{contactContent.header}</h1>
      </header>

      <section class="mb-16">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <div
            class="group scroll-fade-up border-mono-lighter stagger-1 block rounded-2xl border bg-[var(--color-bg-card)] p-8 transition-shadow hover:shadow-lg"
          >
            <div class="mb-6 flex items-start gap-4">
              <div
                class="feature-icon flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-lg bg-[var(--color-orange)] text-white"
              >
                {
                  (() => {
                    const IconComponent =
                      LucideIcons[contactContent.contactGeneral.icon];
                    return <IconComponent class="h-7 w-7" />;
                  })()
                }
              </div>
            </div>
            <div
              class="space-y-4 text-lg leading-relaxed text-gray-700 [&>em]:italic [&>p]:mb-4 [&>strong]:font-semibold"
              set:html={contactGeneralHtml}
            />
          </div>
          <div
            class="group scroll-fade-up border-mono-lighter stagger-2 block rounded-2xl border bg-[var(--color-bg-card)] p-8 transition-shadow hover:shadow-lg"
          >
            <div class="mb-6 flex items-start gap-4">
              <div
                class="feature-icon flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-lg bg-[var(--color-orange)] text-white"
              >
                {
                  (() => {
                    const IconComponent =
                      LucideIcons[contactContent.contactStart.icon];
                    return <IconComponent class="h-7 w-7" />;
                  })()
                }
              </div>
            </div>
            <div
              class="space-y-4 text-lg leading-relaxed text-gray-700 [&>em]:italic [&>p]:mb-4 [&>strong]:font-semibold"
              set:html={contactStartHtml}
            />
          </div>
        </div>
      </section>

      <section class="mb-16">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            contactContent.people.map((person, index) => (
              <article
                class={`group scroll-fade-up border-mono-lighter block rounded-2xl border bg-[var(--color-bg-card)] p-6 stagger-${(index % 9) + 1} transition-shadow hover:shadow-lg`}
              >
                <div class="mb-5">
                  <div class="relative aspect-[4/5] overflow-hidden rounded-xl bg-gray-100">
                    <Image
                      srcset={getImageSrcSet(person.photo)}
                      sizes={imageSizes.contactPhoto}
                      src={person.photo.desktop}
                      alt={`Foto på ${person.name}`}
                      width={400}
                      height={500}
                      class="h-full w-full object-cover"
                      loading="lazy"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="text-mono-dark absolute inset-0 hidden items-center justify-center bg-gray-100 text-3xl font-semibold">
                      {getInitials(person.name)}
                    </div>
                  </div>
                </div>
                <h3 class="text-mono-black card-title mb-1 text-xl font-semibold">
                  {person.name}
                </h3>
                <p class="text-mono-dark mb-4">{person.title}</p>
                <div class="space-y-2 text-sm">
                  <div>
                    <p class="text-mono-gray">Telefon</p>
                    <a
                      href={`tel:${person.phoneNumber}`}
                      class="text-mono-dark hover:text-mono-black"
                    >
                      {person.phoneDisplay}
                    </a>
                  </div>
                  <div>
                    <p class="text-mono-gray">E-post</p>
                    <a
                      href={`mailto:${person.email}`}
                      class="text-mono-dark hover:text-mono-black break-all"
                    >
                      {person.email}
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section>
        <div
          class="group scroll-fade-up border-mono-lighter block rounded-2xl border bg-[var(--color-bg-card)] p-8 transition-shadow hover:shadow-lg md:p-10"
        >
          <h2 class="card-title mb-6 text-2xl font-semibold">
            Bolagsuppgifter
          </h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            <div>
              <p class="text-mono-gray text-sm uppercase">Bolag</p>
              <p class="text-mono-black text-lg font-semibold">
                {contactContent.company.name}
              </p>
            </div>
            <div>
              <p class="text-mono-gray text-sm uppercase">Org.nr</p>
              <p class="text-mono-black text-lg font-semibold">
                {contactContent.company.orgNumber}
              </p>
            </div>
            <div>
              <p class="text-mono-gray text-sm uppercase">Bankgiro</p>
              <p class="text-mono-black text-lg font-semibold">
                {contactContent.company.bankgiro}
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>
