---
import type { ApiEvent } from '../types/api';
import { getTranslations } from '../i18n';
import EventStatusBadge from './EventStatusBadge.astro';
import { Film, MicVocal, Users } from 'lucide-astro';

interface Props {
  event: ApiEvent;
  lang: 'sv' | 'en';
}

const { event, lang } = Astro.props;
const t = getTranslations(lang);

let formatted: string;
try {
  const d = new Date(event.startDateTime);
  if (isNaN(d.getTime())) throw new RangeError('Invalid date');
  formatted = new Intl.DateTimeFormat(lang === 'sv' ? 'sv-SE' : 'en-GB', {
    dateStyle: 'long',
    timeStyle: 'short',
    timeZone: 'Europe/Stockholm',
  }).format(d);
} catch {
  formatted = event.startDateTime;
}

const status: import('../types/api').EventStatus = event.isSoldOut
  ? 'full'
  : event.isActive
    ? 'upcoming'
    : 'past';
const href = event.eventId ? `/events/${event.eventId}` : null;

const iconType =
  event.eventType === 'ItBio'
    ? 'film'
    : event.eventType === 'BeautyInCode'
      ? 'mic'
      : 'users';
---

<article
  class="group border-mono-lighter relative overflow-hidden rounded-xl border bg-[var(--color-bg-card)] transition-shadow hover:shadow-lg"
>
  {
    href && (
      <a href={href} class="absolute inset-0 z-10" aria-label={event.title} />
    )
  }
  <div class="px-8 pt-8 pb-4">
    <div class="mb-4 flex items-center gap-4">
      <div
        class="feature-icon flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-lg bg-[var(--color-orange)] text-white"
      >
        {iconType === 'film' && <Film class="h-7 w-7" />}
        {iconType === 'mic' && <MicVocal class="h-7 w-7" />}
        {iconType === 'users' && <Users class="h-7 w-7" />}
      </div>
      <h2 class="text-mono-black card-title text-xl font-semibold">
        {event.title}
      </h2>
    </div>
    <div class="text-mono-dark mb-1 flex items-center gap-2 text-sm">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="flex-shrink-0"
      >
        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
        <line x1="16" x2="16" y1="2" y2="6"></line>
        <line x1="8" x2="8" y1="2" y2="6"></line>
        <line x1="3" x2="21" y1="10" y2="10"></line>
      </svg>
      <span>{formatted}</span>
    </div>
    <div class="text-mono-gray flex items-center gap-2 text-sm">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="flex-shrink-0"
      >
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <span
        class="inline-block flex-shrink-0 rounded-full bg-[var(--color-orange)] px-2.5 py-0.5 text-xs font-bold text-white"
        >{event.city}</span
      >
      <span>{event.location}</span>
    </div>
    {
      status !== 'upcoming' && (
        <div class="mt-3">
          <EventStatusBadge status={status} translations={t.event} />
        </div>
      )
    }
  </div>
  {
    event.imageUrl && (
      <div class="px-10 pt-2 pb-10">
        <div class="overflow-hidden rounded-[24px] shadow-[0_20px_40px_rgba(0,0,0,0.2),0_6px_18px_rgba(0,0,0,0.12)]">
          <img
            src={event.imageUrl}
            alt={event.title}
            class="block w-full"
            loading="lazy"
          />
        </div>
      </div>
    )
  }
</article>
