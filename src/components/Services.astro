---
import { siteConfig } from '../config.ts';
import * as LucideIcons from 'lucide-astro';
import { servicesContent } from '../content/services';

const serviceUrls: Record<string, string> = {
  'Mjukvaru­konsulting': '/mjukvarukonsulting',
  'Ledarskaps­konsulting': '/ledarskapskonsulting',
  Events: '/events',
};
---

<section
  id="services"
  class="relative bg-bg-main-default px-4 py-20 sm:px-6 lg:px-8"
>
  <div class="mx-auto max-w-7xl">
    <div class="scroll-fade-up mx-auto mb-16 max-w-3xl text-center">
      <h2 class="text-mono-black mb-4 text-4xl font-bold sm:text-5xl">
        {siteConfig.services.title}
      </h2>
      <p class="text-mono-dark text-xl">
        {siteConfig.services.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        servicesContent.map((service, index) => {
          const IconComponent = LucideIcons[service.icon];
          return (
            <a
              href={serviceUrls[service.title]}
              class={`group block ${index % 2 === 0 ? 'scroll-fade-left' : 'scroll-fade-right'} border-mono-lighter rounded-xl border bg-(--color-bg-card) p-8 stagger-${(index % 9) + 1} flex flex-col transition-shadow hover:shadow-lg`}
            >
              <div>
                <div class="mb-3 flex items-center gap-4">
                  <div class="feature-icon flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-orange text-white">
                    <IconComponent class="h-7 w-7" />
                  </div>
                  <h3 class="text-mono-black card-title text-xl font-semibold">
                    {service.title}
                  </h3>
                </div>
                <p class="text-mono-dark leading-relaxed">
                  {service.description}
                </p>
              </div>
              <div class="mt-auto pt-4 text-right">
                <LucideIcons.ArrowRight class="inline h-5 w-5 text-gray-400 opacity-0 transition-opacity group-hover:opacity-100" />
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
