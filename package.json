{
  "name": "livingit-se",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/copy-robots.mjs && astro build",
    "preview": "astro preview",
    "lint": "remark . .agents --ignore-path .gitignore --ignore-pattern .claude --frail --quiet --no-stdout && prettier --check . && node scripts/check-repo-rules.mjs",
    "format": "prettier --write .",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@iconify-json/simple-icons": "^1.2.99",
    "astro": "^6.4.8",
    "astro-icon": "^1.2.0",
    "lucide-astro": "^0.556.0",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.4",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "tailwindcss": "^4.3.0",
    "wrangler": "^4.147.0"
  },
  "prettier": {
    "bracketSpacing": true,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
